{
  "schemaVersion": 1,
  "snapshotDate": "2026-07-01",
  "application": {
    "name": "Spicetify Plus",
    "version": "2.0.0",
    "userAgent": "Spicetify-Plus/2.0.0"
  },
  "official": {
    "organization": "spicetify",
    "repos": [
      "spicetify/cli",
      "spicetify/spicetify-themes",
      "spicetify/winget-pkgs",
      "spicetify/docs",
      "spicetify/marketplace",
      "spicetify/spicetify-creator",
      "spicetify/cors-proxy",
      "spicetify/homebrew-tap",
      "spicetify/.github",
      "spicetify/spicetify-extensions",
      "spicetify/npm-packages",
      "spicetify/xpui-archive",
      "spicetify/pkgs",
      "spicetify/modules",
      "spicetify/classmaps",
      "spicetify/hooks",
      "spicetify/spicetify-lyrics-romaji"
    ],
    "cli": {
      "repo": "spicetify/cli",
      "latestReleaseUrl": "https://api.github.com/repos/spicetify/cli/releases/latest",
      "installScriptUrl": "https://raw.githubusercontent.com/spicetify/cli/main/install.ps1",
      "extensionsPath": "Extensions",
      "customAppsPath": "CustomApps"
    },
    "marketplace": {
      "repo": "spicetify/marketplace",
      "latestReleaseUrl": "https://api.github.com/repos/spicetify/marketplace/releases/latest",
      "installScriptUrl": "https://raw.githubusercontent.com/spicetify/marketplace/main/resources/install.ps1",
      "placeholderColorUrl": "https://raw.githubusercontent.com/spicetify/marketplace/main/resources/color.ini",
      "assetRegex": "^marketplace\\.zip$"
    },
    "themes": {
      "repo": "spicetify/spicetify-themes",
      "branch": "master"
    },
    "builtInCustomApps": [
      {
        "name": "lyrics-plus",
        "description": "Lyrics from multiple providers."
      },
      {
        "name": "new-releases",
        "description": "New releases from followed artists and podcasts."
      },
      {
        "name": "reddit",
        "description": "Browse music shared on Spotify-related subreddits."
      }
    ]
  },
  "communityApps": [
    {
      "name": "spicetify-history",
      "displayName": "Spicetify History",
      "description": "Listening history with export support.",
      "repo": "bc9123/spicetify-history",
      "installName": "spicetify-history",
      "status": "active",
      "resolver": {
        "type": "latestReleaseAsset",
        "assetRegex": "^spicetify-history.*\\.zip$"
      }
    },
    {
      "name": "wmpvis",
      "displayName": "WMPotify NowPlaying",
      "description": "WMP-like visualization screen with lyrics overlay.",
      "repo": "Ingan121/WMPotify",
      "installName": "wmpvis",
      "status": "active",
      "resolver": {
        "type": "repositoryPath",
        "ref": "master",
        "path": "CustomApps/wmpvis/dist"
      }
    },
    {
      "name": "enhancify",
      "displayName": "Enhancify",
      "description": "Enhanced Spotify experience with extra features.",
      "repo": "ECE49595-Team-6/EnhancifyInstall",
      "installName": "enhancify",
      "status": "active",
      "resolver": {
        "type": "latestReleaseAsset",
        "assetRegex": "^EnhancifyInstall.*\\.zip$"
      }
    },
    {
      "name": "lyrixed",
      "displayName": "Lyrixed",
      "description": "Lyrics feature for freemium users.",
      "repo": "Nuzair46/Lyrixed",
      "installName": "lyrixed",
      "status": "active",
      "resolver": {
        "type": "latestReleaseAsset",
        "assetRegex": "^lyrixed\\.zip$"
      }
